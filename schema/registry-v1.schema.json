{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/schedule-one-mods/schedule-one-mod-registry/main/schema/registry-v1.schema.json",
  "title": "Schedule I mod registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mods"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "mods": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/mod"}}
  },
  "$defs": {
    "versions": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["game", "game_versions_tested", "scripting_backend", "platforms_tested", "loader"],
      "properties": {
        "game": {"const": "Schedule I"},
        "game_versions_tested": {"$ref": "#/$defs/versions"},
        "scripting_backend": {"enum": ["IL2CPP", "Mono"]},
        "platforms_tested": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "Windows x64"}},
        "loader": {
          "type": "object", "additionalProperties": false, "required": ["name", "versions_tested"],
          "properties": {"name": {"const": "MelonLoader"}, "versions_tested": {"$ref": "#/$defs/versions"}}
        }
      }
    },
    "mod": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "author", "summary", "repository", "version", "package_name", "download_url", "sha256", "size_bytes", "compatibility"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "author": {"type": "string", "minLength": 1, "maxLength": 80},
        "summary": {"type": "string", "minLength": 1, "maxLength": 200},
        "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "package_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
        "download_url": {"type": "string", "maxLength": 500, "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9][A-Za-z0-9._-]*\\.zip$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "compatibility": {"$ref": "#/$defs/compatibility"}
      }
    }
  }
}
